{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "TradingBot.Worker/Dockerfile"
  },
  "deploy": {
    "startCommand": "dotnet TradingBot.Worker.dll --worker=PriceFetcherWorker",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
